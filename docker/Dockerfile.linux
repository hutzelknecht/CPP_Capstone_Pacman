# Dockerfile for running BobMan Python on Linux
# Phase 2: Resource Loading
# Runs Python directly in container (no PyInstaller bundling needed)
# Output: /app/BobMan (wrapper script that runs the Python app)

FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYSDL2_DLL_PATH=/usr/lib/x86_64-linux-gnu \
    PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # SDL2 and related libraries
    libsdl2-2.0-0 \
    libsdl2-image-2.0-0 \
    libsdl2-ttf-2.0-0 \
    libsdl2-mixer-2.0-0 \
    # Fonts
    fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
RUN pip install --no-cache-dir \
    PySDL2>=0.9.15

# Copy source code and data
WORKDIR /app
COPY bobman/ bobman/
COPY data/ data/
COPY requirements.txt .

# Create the BobMan executable wrapper script at /app/BobMan
# This matches what build-all.sh expects
RUN echo '#!/bin/bash' > /app/BobMan \
    && echo 'export PYSDL2_DLL_PATH=/usr/lib/x86_64-linux-gnu' >> /app/BobMan \
    && echo 'export PYTHONPATH=/app:$PYTHONPATH' >> /app/BobMan \
    && echo 'cd /app/bobman' >> /app/BobMan \
    && echo 'exec /opt/venv/bin/python3 main.py' >> /app/BobMan \
    && chmod +x /app/BobMan

# Set entrypoint to match build-all.sh expectation
ENTRYPOINT ["/app/BobMan"]
