# Dockerfile for running BobMan Python on Windows (experimental)
# Note: This uses Linux with Wine or cross-compilation.
# For best results, build natively on Windows.
# Output: /app/BobMan.exe (wrapper script with .exe extension)

FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYSDL2_DLL_PATH=/usr/lib/x86_64-linux-gnu \
    PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # SDL2 and related libraries
    libsdl2-2.0-0 \
    libsdl2-image-2.0-0 \
    libsdl2-ttf-2.0-0 \
    libsdl2-mixer-2.0-0 \
    # Fonts
    fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
RUN pip install --no-cache-dir \
    PySDL2>=0.9.15

# Copy source code and data
WORKDIR /app
COPY bobman/ bobman/
COPY data/ data/
COPY requirements.txt .

# Create the BobMan.exe executable wrapper script at /app/BobMan.exe
# Using .exe extension for Windows consistency
RUN echo '#!/bin/bash' > /app/BobMan.exe \
    && echo 'export PYSDL2_DLL_PATH=/usr/lib/x86_64-linux-gnu' >> /app/BobMan.exe \
    && echo 'export PYTHONPATH=/app:$PYTHONPATH' >> /app/BobMan.exe \
    && echo 'cd /app/bobman' >> /app/BobMan.exe \
    && echo 'exec /opt/venv/bin/python3 main.py' >> /app/BobMan.exe \
    && chmod +x /app/BobMan.exe

# Set entrypoint
ENTRYPOINT ["/app/BobMan.exe"]
