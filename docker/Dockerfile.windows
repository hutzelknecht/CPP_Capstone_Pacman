# Dockerfile for building BobMan Python on Windows (cross-compile from Linux)
# Uses mingw-w64 to produce Windows .exe
# Phase 2: Resource Loading

FROM ubuntu:22.04 as builder

# Install mingw-w64 and SDL2 for Windows cross-compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    # mingw-w64 toolchain
    mingw-w64 \
    gcc-mingw-w64 \
    g++-mingw-w64 \
    # SDL2 Windows cross-compile libraries
    libsdl2-dev \
    libsdl2-image-dev \
    libsdl2-ttf-dev \
    libsdl2-mixer-dev \
    # Python
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    # Build tools
    make \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
RUN pip install --no-cache-dir \
    PySDL2>=0.9.15 \
    pyinstaller>=6.0.0

# Copy source code and data
WORKDIR /app
COPY bobman/ bobman/
COPY data/ data/
COPY requirements.txt .

# Build with PyInstaller for Windows
# Note: This may require additional SDL2 DLLs for Windows
RUN pyinstaller --onefile --windowed --name BobMan-windows.exe bobman/main.py

# Final stage - copy the .exe
FROM alpine:latest

WORKDIR /app
COPY --from=builder /app/dist/BobMan-windows.exe /app/BobMan.exe

ENTRYPOINT ["/app/BobMan.exe"]
